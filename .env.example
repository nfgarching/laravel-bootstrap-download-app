# ------------------------------------------------------------------------------
# Download-Portal – Vorlage. Kopieren nach .env und ausfüllen.
# Die .env gehört nicht ins Repo (steht in .gitignore).
# ------------------------------------------------------------------------------

APP_NAME="Dokumentenportal"
APP_ENV=production
APP_DEBUG=false
# Erzeugen: php artisan key:generate --show
APP_KEY=
APP_URL=https://download.example.com

APP_LOCALE=de
APP_FALLBACK_LOCALE=de

# --- Portal -------------------------------------------------------------------

# Name, der auf den Abrufseiten als Absender erscheint.
PORTAL_SENDER_NAME="Musterkanzlei"

# Basis der Download-Links (ohne Schrägstrich am Ende). Normalerweise gleich APP_URL.
PORTAL_PUBLIC_URL=https://download.example.com

# Hauptschlüssel des Dateispeichers. Erzeugen: php artisan portal:key
# Verlust oder Austausch macht alle gespeicherten Dateien unlesbar.
PORTAL_MASTER_KEY=
# Alternativ Pfad zu einer Datei mit dem Schlüssel (z. B. Docker Secret):
# PORTAL_MASTER_KEY_FILE=/run/secrets/portal_master_key

# Standardfristen und Grenzen
PORTAL_EXPIRES_DAYS=14
PORTAL_MAX_EXPIRES_DAYS=90
PORTAL_MAX_DOWNLOADS=5
# Maximale Dateigröße in Byte (Standard 1 GB)
PORTAL_MAX_FILE_SIZE=1073741824
PORTAL_RETENTION_DAYS=90
PORTAL_DISPLAY_TIMEZONE=Europe/Berlin

# --- Docker / Traefik (nur für compose.yaml) ----------------------------------

PORTAL_HOST=download.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# --- Laravel ------------------------------------------------------------------

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# Im Container; lokal ohne Docker die Zeile entfernen (dann database/database.sqlite).
DB_DATABASE=/app/database/data/portal.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

HASH_DRIVER=argon2id

# In Phase 1 verschickt das Portal noch keine E-Mails.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="portal@example.com"
MAIL_FROM_NAME="Dokumentenportal"
