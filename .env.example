# ------------------------------------------------------------------------------
# Download-Portal – Vorlage. Kopieren nach .env und ausfüllen.
# Die .env gehört nicht ins Repo (steht in .gitignore).
# ------------------------------------------------------------------------------

APP_NAME="Dokumentenportal"
APP_ENV=production
APP_DEBUG=false
# Erzeugen: php artisan key:generate --show
APP_KEY=
APP_URL=https://download.example.com

APP_LOCALE=de
APP_FALLBACK_LOCALE=de

# --- Portal -------------------------------------------------------------------

# Name, der auf den Abrufseiten als Absender erscheint.
PORTAL_SENDER_NAME="Musterkanzlei"

# Impressum und Datenschutzerklärung (Links im Fuß jeder Seite, z. B. auf der Kanzlei-Website)
PORTAL_IMPRINT_URL=
PORTAL_PRIVACY_URL=

# Basis der Download-Links (ohne Schrägstrich am Ende). Normalerweise gleich APP_URL.
PORTAL_PUBLIC_URL=https://download.example.com

# Hauptschlüssel des Dateispeichers. Erzeugen: php artisan portal:key
# Verlust oder Austausch macht alle gespeicherten Dateien unlesbar.
PORTAL_MASTER_KEY=
# Alternativ Pfad zu einer Datei mit dem Schlüssel (z. B. Docker Secret):
# PORTAL_MASTER_KEY_FILE=/run/secrets/portal_master_key

# Standardfristen und Grenzen
PORTAL_EXPIRES_DAYS=14
PORTAL_MAX_EXPIRES_DAYS=90
PORTAL_MAX_DOWNLOADS=5
# Maximale Dateigröße in Byte (Standard 1 GB)
PORTAL_MAX_FILE_SIZE=1073741824
PORTAL_RETENTION_DAYS=90
PORTAL_DISPLAY_TIMEZONE=Europe/Berlin

# --- Docker / Traefik (nur für compose.yaml) ----------------------------------

PORTAL_HOST=download.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# --- Laravel ------------------------------------------------------------------

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# Im Container; lokal ohne Docker die Zeile entfernen (dann database/database.sqlite).
DB_DATABASE=/app/database/data/portal.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

HASH_DRIVER=argon2id

# E-Mail-Versand des Portals (Bestätigungscode, Hinweis auf neue Dokumente,
# Sicherheitshinweise). Beispiel Google Workspace: smtp.gmail.com, Port 587,
# Benutzer = Postfach, Passwort = App-Passwort des Postfachs.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=portal@example.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="portal@example.com"
MAIL_FROM_NAME="Dokumentenportal"

# --- Empfängerkonten ---------------------------------------------------------

# Konten mit Passkey oder Passwort + Authenticator-App (false = abgeschaltet)
PORTAL_ACCOUNTS=true
# Hostname, an den Passkeys gebunden sind; Standard: Host aus PORTAL_PUBLIC_URL.
# Nach der ersten Einrichtung nicht mehr ändern – sonst funktionieren Passkeys nicht mehr.
# PORTAL_WEBAUTHN_RP_ID=download.example.com
# Zugänge ohne Anmeldung werden nach so vielen Monaten (mit Vorwarnung) gelöscht
PORTAL_ACCOUNT_INACTIVE_MONTHS=24

# Hinweis-Mail an die Kanzlei bei jedem Upload (leer = keine)
PORTAL_NOTIFY_EMAIL=
